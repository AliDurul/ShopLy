{
  "name": "shoply-server",
  "version": "1.0.0",
  "description": "ShopLy microservices workspace",
  "type": "commonjs",
  "private": true,
  "workspaces": [
    "api-gateway",
    "auth-service"
  ],
  "scripts": {
    "dev:all": "concurrently \"yarn workspace api-gateway dev\" \"yarn workspace auth-service dev\"",
    "dev:gateway": "yarn workspace api-gateway dev",
    "dev:auth": "yarn workspace auth-service dev",
    "build:all": "yarn workspaces run build",
    "build:gateway": "yarn workspace api-gateway build",
    "build:auth": "yarn workspace auth-service build",
    "start:all": "yarn workspaces run start",
    "start:gateway": "yarn workspace api-gateway start",
    "start:auth": "yarn workspace auth-service start",
    "db:deploy": "yarn workspace auth-service db:deploy",
    "db:migrate": "yarn workspace auth-service db:migrate",
    "db:studio": "yarn workspace auth-service db:studio"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "http-proxy-middleware": "^3.0.5",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^25.0.10",
    "concurrently": "^9.2.1",
    "nodemon": "^3.1.11",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  }
}
