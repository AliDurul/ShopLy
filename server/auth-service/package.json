{
  "name": "auth-service",
  "version": "1.0.0",
  "description": "Authentication service",
  "main": "dist/auth-service/src/server.js",
  "type": "commonjs",
  "scripts": {
    "dev": "nodemon --watch src --ext ts,js --exec \"npx ts-node -r tsconfig-paths/register --transpile-only src/server.ts\"",
    "start": "node dist/auth-service/src/server.js",
    "db:deploy": "npx prisma migrate deploy && npx prisma generate",
    "db:generate": "npx prisma generate",
    "db:migrate": "npx prisma migrate",
    "db:studio": "npx prisma studio",
    "build": "tsc && tsc-alias"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/adapter-pg": "^7.3.0",
    "@prisma/client": "^7.3.0",
    "pg": "^8.17.2"
  },
  "devDependencies": {
    "prisma": "^7.3.0"
  }
}
